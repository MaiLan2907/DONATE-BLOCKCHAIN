# Cổng chạy backend
PORT=4000

# Địa chỉ ví ADMIN (owner của smart contract).
# Chỉ ví này mới được phép gọi API ghi (POST/PATCH/DELETE).
# Backend dùng `ethers.verifyMessage` để xác thực chữ ký - không thể giả mạo.
ADMIN_WALLET=0x54d1BA8938A5bBc93cAc264cBd02c32F96e4f666

# URL frontend được phép gọi API (CORS)
CORS_ORIGIN=http://localhost:3000

# Số phút mà chữ ký đăng nhập admin còn hiệu lực
ADMIN_SIGNATURE_TTL_MIN=720
